#include <stdio.h>
#include <string.h>

int main() {
    int n, i;
    char data[100];

    printf("Enter number of frames: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        printf("Enter frame data: ");
        scanf("%s", data);

        printf("Frame %d: %s\n", i, data);
    }

    return 0;
}
