#include <stdio.h>
#define INF 999

int main() {
    int n, c[10][10], d[10][10];

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter cost matrix (999 = no link):\n");

    for(int i=0; i<n; i++)
        for(int j=0; j<n; j++) {
            scanf("%d", &c[i][j]);
            d[i][j] = c[i][j];
        }

    for(int k=0; k<n; k++)
        for(int i=0; i<n; i++)
            for(int j=0; j<n; j++)
                if(d[i][k] + d[k][j] < d[i][j])
                    d[i][j] = d[i][k] + d[k][j];

    for(int i=0; i<n; i++) {
        printf("\nRouting table of Node %d\n", i);

        for(int j=0; j<n; j++)
            printf("%d -> %d = %d\n", i, j, d[i][j]);
    }

    return 0;
}
