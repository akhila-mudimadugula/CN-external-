#include <stdio.h>
#include <string.h>

int main() {
    char data[100];
    char poly[] = "10001000000100001";
    int n, m = strlen(poly), error = 0;

    printf("Enter received codeword: ");
    scanf("%s", data);

    n = strlen(data);

    for(int i=0; i<=n-m; i++)
        if(data[i]=='1')
            for(int j=0; j<m; j++)
                data[i+j] =
                (data[i+j]==poly[j]) ? '0':'1';

    for(int i=n-m+1; i<n; i++)
        if(data[i]=='1')
            error=1;

    if(error)
        printf("Error detected");
    else
        printf("No error");

    return 0;
}
