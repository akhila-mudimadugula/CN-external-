#include <stdio.h>
#include <string.h>

int main() {
    char data[100], temp[100];
    char poly[] = "10001000000100001";
    int n, m = strlen(poly);

    printf("Enter data: ");
    scanf("%s", data);

    n = strlen(data);
    strcpy(temp, data);

    for(int i=0; i<m-1; i++)
        temp[n+i]='0';

    temp[n+m-1]='\0';

    for(int i=0; i<n; i++)
        if(temp[i]=='1')
            for(int j=0; j<m; j++)
                temp[i+j] =
                (temp[i+j]==poly[j]) ? '0':'1';

    printf("CRC: ");
    for(int i=n; i<n+m-1; i++)
        printf("%c", temp[i]);

    return 0;
}
